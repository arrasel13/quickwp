{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora",
  "mainBinaryName": "nexora-app",
  "version": "0.1.1",
  "identifier": "com.nexora.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexora",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1e1e1e",
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Nexora",
    "category": "DeveloperTool",
    "shortDescription": "WordPress development environment manager",
    "longDescription": "A desktop application for managing WordPress sites with Laravel Herd and WP-CLI integration",
    "copyright": "Copyright \u00a9 2024 Nexora. All rights reserved.",
    "license": "MIT",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "localhost"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "resources": {
      "bundled/nexora-edge": "nexora-edge",
      "bundled/nexora": "nexora"
    }
  }
}